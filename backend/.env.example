ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
# Minimal-faith style (retention upgrade plan phase 7): royalty-free music
# beds, keyed by mood. Format: mood=path,mood=path (paths may use ~).
MUSIC_DIRS=slow=~/Music/Music/slowmusic,cinematic=~/Music/Music/cinematic
# DaVinci Resolve Sound Library folder on disk (whoosh/riser/impact SFX).
# Leave empty to skip SFX silently.
SFX_DIR=~/Downloads/SFX
# Speaker diarization (optional): a Hugging Face token whose account has
# accepted the pyannote/speaker-diarization-3.1 and segmentation-3.0 terms.
HF_TOKEN=
# Visual rerank of shortlisted clips (0 to turn off) and its model.
VISUAL_RERANK=1
CLAUDE_VISUAL_MODEL=claude-opus-5-5
# Clip lengths in seconds: Shorts (default) and long-form ("Long-form clips").
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=45
CLIP_TARGET_MIN_SECONDS=20
CLIP_TARGET_MAX_SECONDS=35
LONG_CLIP_MIN_SECONDS=45
LONG_CLIP_MAX_SECONDS=90
