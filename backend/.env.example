ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
# Minimal-faith style (retention upgrade plan phase 7): royalty-free music
# beds, keyed by mood. Format: mood=path,mood=path (paths may use ~).
MUSIC_DIRS=slow=~/Music/Music/slowmusic,cinematic=~/Music/Music/cinematic
# DaVinci Resolve Sound Library folder on disk (whoosh/riser/impact SFX).
# Leave empty to skip SFX silently.
SFX_DIR=~/Downloads/SFX
