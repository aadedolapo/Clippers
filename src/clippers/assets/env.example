# Clippers settings. `clippers init` copies this to ~/Clippers/.env
# (or $CLIPPERS_HOME/.env). Only ANTHROPIC_API_KEY is required; every other
# feature skips itself when its setting is empty.

# --- Required -----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Your channel -------------------------------------------------------------
# What the channel is about, and its core topics ("lanes"), comma-separated.
# The scorer rates how well each clip fits the lanes, and the shortlist takes
# at most one clip per lane. Leave both empty for a general-purpose channel.
# CHANNEL_DESCRIPTION=a faith and self-improvement channel for young men
# CHANNEL_LANES=faith, men's growth, discipline, purpose
CHANNEL_DESCRIPTION=
CHANNEL_LANES=

# --- Optional services --------------------------------------------------------
# Pexels stock footage for B-roll suggestions.
PEXELS_API_KEY=
# ElevenLabs narration for the spoken outro.
ELEVENLABS_API_KEY=
# Speaker diarization (needs `pip install "clippers[diarization]"`): a Hugging
# Face token whose account has accepted the pyannote/speaker-diarization-3.1
# and pyannote/segmentation-3.0 model terms.
HF_TOKEN=

# --- Music and sound effects --------------------------------------------------
# Music beds by mood, as mood=folder pairs (folders may use ~), e.g.
# MUSIC_DIRS=slow=~/Music/slow,cinematic=~/Music/cinematic
MUSIC_DIRS=
# A folder of whoosh/riser/impact sound effects, e.g. DaVinci Resolve's
# Sound Library folder.
SFX_DIR=

# --- Scoring ------------------------------------------------------------------
# Visual rerank of shortlisted clips (0 turns it off) and its model.
VISUAL_RERANK=1
CLAUDE_VISUAL_MODEL=claude-opus-5-5
# faster-whisper model size: tiny, base, small, medium, large-v3.
WHISPER_MODEL_SIZE=small

# --- Clip lengths (seconds) ---------------------------------------------------
# Shorts (the default) and long-form ("Long-form clips" in the app).
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=45
CLIP_TARGET_MIN_SECONDS=20
CLIP_TARGET_MAX_SECONDS=35
LONG_CLIP_MIN_SECONDS=45
LONG_CLIP_MAX_SECONDS=90
LONG_CLIP_TARGET_MIN_SECONDS=60
LONG_CLIP_TARGET_MAX_SECONDS=75
